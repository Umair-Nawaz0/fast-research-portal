# PostgreSQL Database Connection URL
# For local Unix domain socket (peer authentication):
# DATABASE_URL=postgresql+psycopg2://username@/research_opportunity_portal
# For TCP localhost connection:
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/research_opportunity_portal

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server Configuration
HOST=127.0.0.1
PORT=8000
