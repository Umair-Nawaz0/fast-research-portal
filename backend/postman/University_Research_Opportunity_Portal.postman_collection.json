    {
      "name": "14. Validation Error: Negative Available Positions (Expect 422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Invalid Positions Opportunity\",\n  \"department\": \"Computer Science\",\n  \"faculty_name\": \"Dr. Valid Mentor\",\n  \"research_area\": \"AI & Data Science\",\n  \"description\": \"Valid description exceeding minimum character requirement.\",\n  \"required_skills\": [\"Python\"],\n  \"available_positions\": -5,\n  \"application_deadline\": \"2026-12-01\",\n  \"status\": \"Open\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/opportunities",
          "host": ["{{baseUrl}}"],
          "path": ["api", "opportunities"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 422 Unprocessable Entity', function () {",
              "    pm.response.to.have.status(422);",
              "});",
              "pm.test('Validation error specifies available_positions constraint', function () {",
              "    var jsonData = pm.response.json();",
              "    var fieldErrors = jsonData.detail.map(function(d) { return d.loc.join('.'); });",
              "    pm.expect(fieldErrors.some(function(loc) { return loc.includes('available_positions'); })).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
