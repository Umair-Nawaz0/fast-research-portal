    {
      "name": "1. Create Opportunity 1 (SDN)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Software-Defined Networking (SDN) Flow Optimization for Data Centers\",\n  \"department\": \"Computer Networks & Security\",\n  \"faculty_name\": \"Dr. Tariq Mahmood\",\n  \"research_area\": \"Software-Defined Networking (SDN)\",\n  \"description\": \"Investigating intelligent routing policies using OpenFlow and P4 programmable switches to mitigate congestion in multi-tenant cloud data centers.\",\n  \"required_skills\": [\"Python\", \"Mininet\", \"OpenFlow\", \"Wireshark\"],\n  \"available_positions\": 3,\n  \"application_deadline\": \"2026-11-15\",\n  \"status\": \"Open\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/opportunities",
          "host": ["{{baseUrl}}"],
          "path": ["api", "opportunities"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Opportunity 1 created with valid ID', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData.title).to.include('Software-Defined Networking');",
              "    pm.expect(jsonData.available_positions).to.eql(3);",
              "    pm.collectionVariables.set('opportunityId1', jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
